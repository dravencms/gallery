<form n:name="form" class="card">
    <ul class="alert alert-danger" n:if="$form->hasErrors()">
        <li n:foreach="$form->errors as $error">{$error}</li>
    </ul>
    <div class="card-body">
        <ul class="nav nav-tabs" role="tablist">
            <li n:foreach="$activeLocales as $activeLocale" role="presentation" class="nav-item"><a n:class="$activeLocale->isDefault() ? active, nav-link" href="#{$activeLocale->getLanguageCode()}" aria-controls="home"
                                                                                                                                 role="tab" data-bs-toggle="tab"><span
                            class="flag-icon flag-icon-{$activeLocale->getCountry()->getCode()|lower}"></span> {$activeLocale->getName()}</a></li>
        </ul>
        <div class="tab-content">
            <div n:foreach="$activeLocales as $activeLocale" role="tabpanel" n:class="$activeLocale->isDefault() ? active, tab-pane" id="{$activeLocale->getLanguageCode()}">
                {formContainer $activeLocale->getLanguageCode()}
                    <fieldset>
                        <legend>{$activeLocale->getName()}</legend>
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="mb-3">
                                    <label class="form-label" n:name="name">{_'gallery.admin.field.name'}</label>
                                    <input type="text" n:name="name" autofocus="autofocus" class="form-control">
                                </div>
                            </div><!-- col-sm-12 -->
                        </div><!-- row -->

                        <div class="row">
                            <div class="col-sm-12">
                                <div class="mb-3">
                                    <label class="form-label" n:name="description">{_'gallery.admin.field.description'}</label>
                                    <textarea n:name="description" class="form-control"></textarea>
                                </div>
                            </div><!-- col-sm-12 -->
                        </div><!-- row -->
                    </fieldset>
                {/formContainer}
            </div>
        </div>
        <div class="col-sm-12 mb-3">{label structureFile /}{input structureFile}</div>

        <div class="row">
            <div class="col-sm-12">
                <div class="mb-3">
                    <label class="form-label" n:name="tags">{_'gallery.admin.field.tags'}</label>
                    <select n:name="tags" class="form-control"></select>
                </div>
            </div><!-- col-sm-12 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="identifier">{_'gallery.admin.field.identifier'}</label>
                    <input n:name="identifier" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
            <div class="col-sm-6">
                <div class="mb-3">
                    <label class="form-label" n:name="position">{_'gallery.admin.field.position'}</label>
                    <input n:name="position" class="form-control">
                </div>
            </div><!-- col-sm-6 -->
        </div><!-- row -->

        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isActive" class="form-check-input"> <span class="form-check-label">{_'gallery.admin.field.active'}</span>
                    </label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="form-check">
                    <label>
                        <input type="checkbox" n:name="isPrimary" class="form-check-input"> <span class="form-check-label">{_'gallery.admin.field.primaryPicture'}</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer">
        <input type="submit" n:name="send" class="btn btn-success button" value="{_'gallery.admin.action.save'}">
    </div>
</form>
